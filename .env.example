# PostgreSQL
POSTGRES_DB=main_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Django Backend
DJANGO_SECRET_KEY=dev-secret-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Redis
REDIS_URL=redis://redis_server:6379/0

# AI Worker Internal Callback
JOB_CALLBACK_URL=http://main-service:8000/api/internal/worker-callback

# Optional LLM API Keys (System has offline heuristic fallback if keys are blank)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
