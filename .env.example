# Production Django Settings
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-here-32-chars
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://your-server-ip:5173

# AI & LLM Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL & Redis
POSTGRES_DB=main_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis_server:6379/0